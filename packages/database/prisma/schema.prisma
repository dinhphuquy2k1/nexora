generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StoredFile {
  id        String   @id @db.Uuid
  sha256    String   @db.VarChar(64)
  sizeBytes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("stored_files")
}

model User {
  id         String          @id @default(uuid()) @db.Uuid
  username   String          @unique @db.VarChar(50)
  role       String          @db.VarChar(16)
  status     String          @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential UserCredential?
  carrierConnections CarrierConnection[]
  carrierState CarrierUserState?
  mfa UserMfa?
  mfaChallenges MfaChallenge[]
  sessions   Session[]
  setupTokens OperatorSetupToken[] @relation("setup_target")
  issuedSetupTokens OperatorSetupToken[] @relation("setup_issuer")

  @@map("users")
}

model OperatorSetupToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  issuedBy String @map("issued_by") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation("setup_target", fields:[userId], references:[id], onDelete:Cascade)
  issuer User @relation("setup_issuer", fields:[issuedBy], references:[id], onDelete:Cascade)
  @@index([userId])
  @@map("operator_setup_tokens")
}

model UserCredential {
  userId       String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.VarChar(255)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  authLevel String @default("PASSWORD") @map("auth_level") @db.VarChar(16)
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model CarrierConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  provider String @db.VarChar(32)
  externalAccountId String @map("external_account_id") @db.VarChar(128)
  loginIdentifier String? @map("login_identifier") @db.VarChar(128)
  displayName String @map("display_name") @db.VarChar(100)
  status String @db.VarChar(32)
  lifecycleVersion Int @default(0) @map("lifecycle_version")
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  secrets CarrierConnectionSecret[]
  @@unique([provider,externalAccountId],map:"uq_carrier_connections_provider_account")
  @@index([userId,provider],map:"idx_carrier_connections_user_provider")
  @@map("carrier_connections")
}

model CarrierConnectionSecret {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  secretType String @map("secret_type") @db.VarChar(32)
  ciphertext String @db.Text
  nonce String @db.VarChar(64)
  authTag String @map("auth_tag") @db.VarChar(64)
  keyVersion Int @map("key_version")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection CarrierConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  @@unique([connectionId,secretType],map:"uq_carrier_secrets_connection_type")
  @@map("carrier_connection_secrets")
}

model CarrierUserState {
  userId String @id @map("user_id") @db.Uuid
  generation Int @default(0)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("carrier_user_states")
}

model SecurityAuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  eventType String @map("event_type") @db.VarChar(32)
  outcome String @db.VarChar(16)
  reason String @db.VarChar(32)
  userId String? @map("user_id") @db.Uuid
  connectionId String? @map("connection_id") @db.Uuid
  provider String @db.VarChar(32)
  correlationId String @map("correlation_id") @db.Uuid
  @@index([connectionId,createdAt],map:"idx_security_audit_connection_time")
  @@map("security_audit_events")
}

model UserMfa {
  userId String @id @map("user_id") @db.Uuid
  ciphertext String @map("totp_secret_ciphertext") @db.Text
  nonce String @db.VarChar(64)
  authTag String @map("auth_tag") @db.VarChar(64)
  keyVersion Int @map("key_version")
  lastUsedStep BigInt @map("last_used_step")
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  recoveryCodes MfaRecoveryCode[]
  @@map("user_mfa")
}
model MfaChallenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}
model MfaRecoveryCode {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  codeHash String @map("code_hash") @db.VarChar(64)
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  mfa UserMfa @relation(fields:[userId],references:[userId],onDelete:Cascade)
  @@unique([userId,codeHash])
  @@map("mfa_recovery_codes")
}
