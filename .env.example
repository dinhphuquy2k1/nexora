# Nexora environment configuration example
#
# Canonical Docker Compose automatically configures internal networking.
# This file serves as reference documentation for environment variables.
# Do NOT store secrets, passwords, or production keys in this file.

# Required Web API upstream URL (resolvable within Nexora Docker bridge network)
API_INTERNAL_URL=http://api:4000

# Optional host loopback port for Nexora Web (default: 127.0.0.1:3001)
# WEB_PORT=127.0.0.1:3001

# Optional PostgreSQL host port (development only).
# Always bound to 127.0.0.1.
# POSTGRES_PORT=5432

# Optional LOCAL Web ingress allowed hostnames, forwarded by standard/dev/release Compose.
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Optional replacement API mutation origins (exact scheme/host/effective port).
# WEB_PORT/ALLOWED_ORIGINS reach the actual API dev child through strict Turbo.
# By default the API derives loopback HTTP origins from WEB_PORT, including a changed port.
# ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Uniship authentication configuration (API base URL, not the login endpoint path).
# API integration authorization is owner-confirmed.
# The deployment administrator is responsible for configuring this URL.
UNISHIP_API_URL=https://kh.uniship.vn

# Explicitly enable authorized live integration when ready.
UNISHIP_LIVE_AUTHORIZED=false

# Server-only Carrier keyring for API and Sync Worker; never Web/build/cache.
# Supply securely at deployment; never use example keys.
# CARRIER_KEYRING_JSON={"1":"<canonical-base64-of-32-random-bytes>"}
# CARRIER_ACTIVE_KEY_VERSION=1

# Independent Identity key custody for API and trusted CLI only, including dev.
# Securely supply random32byte keys; never share with Worker or Carrier.
# IDENTITY_KEYRING_JSON={"1":"<canonical-base64-of-32-independent-random-bytes>"}
# IDENTITY_ACTIVE_KEY_VERSION=1

# Global Sync kill switch. Persisted schedules never authorize a missing capability.
SYNC_ENABLED=false

# Controlled runtime remains OFF without an owner-scoped activation declaration.
# Owner supplies ownerUserId, externalAccountId, loginIdentifier, mode MANUAL_ONLY
# or AUTOMATIC and optional connectionId. Never put passwords/tokens in this JSON.
UNISHIP_ACTIVATION_POLICY_JSON=
# Optional owner-approved reconciliation thresholds; absent means ingestion only.
# No production thresholds are supplied by this repository.
UNISHIP_RECONCILIATION_POLICY_JSON=

# Shared API/Worker Sync tuning. Empty values resolve to these Compose defaults.
# SYNC_LEASE_SECONDS=60
# SYNC_POLL_MS=1000
# SYNC_MAX_ATTEMPTS=5
# No retention duration is selected by default; empty disables cleanup.
# SYNC_RESOLVED_RETENTION_DAYS=

# Host-native Turbo does not auto-load .env: supply runtime values in the parent
# environment. Restart dev processes after changes; recreate Compose containers
# for changed environment. Preserve database credentials and all key versions.
