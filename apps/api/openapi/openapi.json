{
  "openapi": "3.0.0",
  "paths": {
    "/api/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveDto"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyErrorDto"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Yêu cầu không hợp lệ hoặc thiếu thông tin"
          },
          "401": {
            "description": "Thông tin xác thực không chính xác"
          },
          "403": {
            "description": "Origin không hợp lệ hoặc không được phép"
          },
          "429": {
            "description": "Quá nhiều lần đăng nhập thất bại"
          }
        },
        "summary": "Xác thực danh tính và thiết lập phiên làm việc",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "AuthController_getSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Phiên làm việc hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc phiên đã hết hạn"
          }
        },
        "summary": "Kiểm tra phiên làm việc hiện tại",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Đăng xuất thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Origin không hợp lệ hoặc không được phép"
          }
        },
        "summary": "Hủy bỏ phiên làm việc và xóa cookie",
        "tags": [
          "Authentication"
        ]
      }
    }
  },
  "info": {
    "title": "Nexora foundation",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LiveDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "boolean"
          },
          "storage": {
            "type": "boolean"
          }
        },
        "required": [
          "database",
          "storage"
        ]
      },
      "ReadyDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/ChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ReadyErrorDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/ChecksDto"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks",
          "code",
          "message",
          "requestId"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Tên đăng nhập",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu",
            "example": "secret123"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Mã định danh người dùng"
          },
          "username": {
            "type": "string",
            "description": "Tên đăng nhập"
          }
        },
        "required": [
          "id",
          "username"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "Trạng thái xác thực",
            "example": true
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "authenticated",
          "user"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Kết quả đăng xuất",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      }
    }
  }
}
