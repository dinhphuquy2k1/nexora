{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@nexora/database#build": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "@nexora/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CARRIER_KEYRING_JSON",
        "CARRIER_ACTIVE_KEY_VERSION",
        "UNISHIP_API_URL",
        "UNISHIP_LIVE_AUTHORIZED",
        "UNISHIP_ACTIVATION_POLICY_JSON",
        "UNISHIP_RECONCILIATION_POLICY_JSON",
        "SYNC_ENABLED",
        "SYNC_LEASE_SECONDS",
        "SYNC_POLL_MS",
        "SYNC_MAX_ATTEMPTS",
        "SYNC_RESOLVED_RETENTION_DAYS",
        "TSC_WATCHFILE",
        "TSC_WATCHDIRECTORY"
      ]
    },
    "@nexora/shared#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TSC_WATCHFILE", "TSC_WATCHDIRECTORY"]
    },
    "@nexora/database#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["TSC_WATCHFILE", "TSC_WATCHDIRECTORY"]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "STORAGE_ROOT",
    "API_DOCS_ENABLED",
    "PORT",
    "NODE_ENV",
    "API_INTERNAL_URL",
    "NEXT_TELEMETRY_DISABLED"
  ]
}
