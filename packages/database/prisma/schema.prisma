generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StoredFile {
  id        String   @id @db.Uuid
  sha256    String   @db.VarChar(64)
  sizeBytes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("stored_files")
}

model User {
  id         String          @id @default(uuid()) @db.Uuid
  username   String          @unique @db.VarChar(50)
  role       String          @db.VarChar(16)
  status     String          @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential UserCredential?
  sessions   Session[]
  setupTokens OperatorSetupToken[] @relation("setup_target")
  issuedSetupTokens OperatorSetupToken[] @relation("setup_issuer")

  @@map("users")
}

model OperatorSetupToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  issuedBy String @map("issued_by") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation("setup_target", fields:[userId], references:[id], onDelete:Cascade)
  issuer User @relation("setup_issuer", fields:[issuedBy], references:[id], onDelete:Cascade)
  @@index([userId])
  @@map("operator_setup_tokens")
}

model UserCredential {
  userId       String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.VarChar(255)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
