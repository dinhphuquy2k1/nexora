# Nexora environment configuration example
#
# Canonical Docker Compose automatically configures internal networking.
# This file serves as reference documentation for environment variables.
# Do NOT store secrets, passwords, or production keys in this file.

# Required Web API upstream URL (resolvable within Nexora Docker bridge network)
API_INTERNAL_URL=http://api:4000

# Optional host loopback port for Nexora Web (default: 127.0.0.1:3001)
# WEB_PORT=127.0.0.1:3001

# Optional PostgreSQL host port (development only).
# Always bound to 127.0.0.1.
# POSTGRES_PORT=5432

# Optional Web ingress allowed hostnames (comma-separated)
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Optional replacement API mutation origins (exact scheme/host/effective port).
# By default the API derives loopback HTTP origins from WEB_PORT, including a changed port.
# ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Uniship authentication configuration (API base URL, not the login endpoint path).
# API integration authorization is owner-confirmed.
# The deployment administrator is responsible for configuring this URL.
UNISHIP_API_URL=https://kh.uniship.vn

# Explicitly enable authorized live integration when ready.
UNISHIP_LIVE_AUTHORIZED=false

# Server-only Carrier keyring: supply securely at deployment; never use example keys.
# CARRIER_KEYRING_JSON={"1":"<canonical-base64-of-32-random-bytes>"}
# CARRIER_ACTIVE_KEY_VERSION=1

# Independent server-only Identity key custody; securely supply random32byte keys.
# IDENTITY_KEYRING_JSON={"1":"<canonical-base64-of-32-independent-random-bytes>"}
# IDENTITY_ACTIVE_KEY_VERSION=1
