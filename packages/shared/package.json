{
  "name": "@nexora/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./customer-status": {
      "types": "./dist/customer-status.d.ts",
      "default": "./dist/customer-status.js"
    },
    "./sync-status": {
      "types": "./dist/sync-status.d.ts",
      "default": "./dist/sync-status.js"
    },
    "./shipment": {
      "types": "./dist/shipment/index.d.ts",
      "default": "./dist/shipment/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "validation": [
        "dist/validation/index.d.ts"
      ],
      "customer-status": [
        "dist/customer-status.d.ts"
      ],
      "sync-status": [
        "dist/sync-status.d.ts"
      ],
      "shipment": [
        "dist/shipment/index.d.ts"
      ]
    }
  }
}
