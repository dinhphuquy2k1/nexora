# Nexora environment configuration example
#
# Canonical Docker Compose automatically configures internal networking.
# This file serves as reference documentation for environment variables.
# Do NOT store secrets, passwords, or production keys in this file.

# Required Web API upstream URL (resolvable within Nexora Docker bridge network)
API_INTERNAL_URL=http://api:4000

# Optional host loopback port for Nexora Web (default: 127.0.0.1:3001)
# WEB_PORT=127.0.0.1:3001

# Optional Web ingress allowed hostnames (comma-separated)
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Optional API mutation allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
