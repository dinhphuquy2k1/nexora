generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StoredFile {
  id        String   @id @db.Uuid
  sha256    String   @db.VarChar(64)
  sizeBytes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("stored_files")
}

model User {
  id         String          @id @default(uuid()) @db.Uuid
  username   String          @unique @db.VarChar(50)
  role       String          @db.VarChar(16)
  status     String          @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  syncJobs SyncJob[]
  syncSources SyncSourceIdentity[]
  ownedCustomers Customer[] @relation("customer_owner")
  createdCustomers Customer[] @relation("customer_creator")
  credential UserCredential?
  carrierConnections CarrierConnection[]
  carrierState CarrierUserState?
  mfa UserMfa?
  mfaChallenges MfaChallenge[]
  sessions   Session[]
  setupTokens OperatorSetupToken[] @relation("setup_target")
  issuedSetupTokens OperatorSetupToken[] @relation("setup_issuer")

  @@map("users")
}

model OperatorSetupToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  issuedBy String @map("issued_by") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation("setup_target", fields:[userId], references:[id], onDelete:Cascade)
  issuer User @relation("setup_issuer", fields:[issuedBy], references:[id], onDelete:Cascade)
  @@index([userId])
  @@map("operator_setup_tokens")
}

model UserCredential {
  userId       String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.VarChar(255)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  authLevel String @default("PASSWORD") @map("auth_level") @db.VarChar(16)
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model CarrierConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  provider String @db.VarChar(32)
  externalAccountId String @map("external_account_id") @db.VarChar(128)
  loginIdentifier String? @map("login_identifier") @db.VarChar(128)
  displayName String @map("display_name") @db.VarChar(100)
  status String @db.VarChar(32)
  lifecycleVersion Int @default(0) @map("lifecycle_version")
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  secrets CarrierConnectionSecret[]
  syncConfigs SyncConfig[]
  syncJobs SyncJob[]
  @@unique([provider,externalAccountId],map:"uq_carrier_connections_provider_account")
  @@index([userId,provider],map:"idx_carrier_connections_user_provider")
  @@map("carrier_connections")
}

model CarrierConnectionSecret {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  secretType String @map("secret_type") @db.VarChar(32)
  ciphertext String @db.Text
  nonce String @db.VarChar(64)
  authTag String @map("auth_tag") @db.VarChar(64)
  keyVersion Int @map("key_version")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection CarrierConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  @@unique([connectionId,secretType],map:"uq_carrier_secrets_connection_type")
  @@map("carrier_connection_secrets")
}

model CarrierUserState {
  userId String @id @map("user_id") @db.Uuid
  generation Int @default(0)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("carrier_user_states")
}

model SecurityAuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  eventType String @map("event_type") @db.VarChar(32)
  outcome String @db.VarChar(16)
  reason String @db.VarChar(32)
  userId String? @map("user_id") @db.Uuid
  connectionId String? @map("connection_id") @db.Uuid
  provider String @db.VarChar(32)
  correlationId String @map("correlation_id") @db.Uuid
  @@index([connectionId,createdAt],map:"idx_security_audit_connection_time")
  @@map("security_audit_events")
}

model UserMfa {
  userId String @id @map("user_id") @db.Uuid
  ciphertext String @map("totp_secret_ciphertext") @db.Text
  nonce String @db.VarChar(64)
  authTag String @map("auth_tag") @db.VarChar(64)
  keyVersion Int @map("key_version")
  lastUsedStep BigInt @map("last_used_step")
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  recoveryCodes MfaRecoveryCode[]
  @@map("user_mfa")
}
model MfaChallenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}
model MfaRecoveryCode {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  codeHash String @map("code_hash") @db.VarChar(64)
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  mfa UserMfa @relation(fields:[userId],references:[userId],onDelete:Cascade)
  @@unique([userId,codeHash])
  @@map("mfa_recovery_codes")
}

model Customer {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 ownerUserId String @map("owner_user_id") @db.Uuid
 code String @unique(map:"uq_customers_code") @default(dbgenerated("next_customer_code()")) @db.VarChar(32)
 name String @db.VarChar(200)
 phone String @map("phone_normalized") @db.VarChar(16)
 email String? @db.VarChar(254)
 note String? @db.Text
 status String @default("ACTIVE") @db.VarChar(16)
 createdByUserId String @map("created_by_user_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
 owner User @relation("customer_owner",fields:[ownerUserId],references:[id],onDelete:Restrict)
 creator User @relation("customer_creator",fields:[createdByUserId],references:[id],onDelete:Restrict)
 addresses CustomerAddress[]
 syncSources SyncSourceIdentity[]
 @@unique([ownerUserId,phone],map:"uq_customers_owner_phone")
 @@index([ownerUserId,createdAt(sort:Desc),id(sort:Desc)],map:"idx_customers_owner_created")
 @@index([ownerUserId,status,createdAt(sort:Desc),id(sort:Desc)],map:"idx_customers_owner_status_created")
 @@map("customers")
}
model CustomerAddress {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 customerId String @map("customer_id") @db.Uuid
 label String? @db.VarChar(100)
 recipientName String @map("recipient_name") @db.VarChar(200)
 recipientPhone String @map("recipient_phone") @db.VarChar(16)
 countryCode String @default("VN") @map("country_code") @db.VarChar(2)
 addressText String @map("address_text") @db.Text
 isDefault Boolean @default(false) @map("is_default")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 // Partial unique index uq_customer_addresses_default is owned by SQL migration.
 @@index([customerId,createdAt,id],map:"idx_customer_addresses_customer_created")
 @@map("customer_addresses")
}

model SyncConfig {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 carrier_connection_id String @db.Uuid
 sync_type String @db.VarChar(32)
 enabled Boolean @default(false)
 interval_minutes Int
 next_run_at DateTime? @db.Timestamptz(3)
 last_success_at DateTime? @db.Timestamptz(3)
 last_completed_at DateTime? @db.Timestamptz(3)
 last_completed_watermark String? @db.Text
 created_at DateTime @default(now()) @db.Timestamptz(3)
 updated_at DateTime @default(now()) @db.Timestamptz(3)
 connection CarrierConnection @relation(fields:[carrier_connection_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
 @@unique([carrier_connection_id,sync_type])
 // Partial enabled next_run_at index is SQL-owned by 20261104000000_sync_fk_indexes.
 @@map("sync_configs")
}
model SyncJob {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 carrier_connection_id String? @db.Uuid
 owner_user_id String @db.Uuid
 provider String @db.VarChar(32)
 external_account_id String @db.VarChar(128)
 sync_type String @db.VarChar(32)
 trigger_source String @db.VarChar(16)
 status String @default("QUEUED") @db.VarChar(16)
 processing_phase String @default("FETCHING") @db.VarChar(16)
 generation Int
 lifecycle_version Int
 fetch_strategy String @default("FULL") @db.VarChar(16)
 next_page Int @default(1)
 next_cursor String? @db.Text
 target_watermark String? @db.Text
 fetched_count Int @default(0)
 new_count Int @default(0)
 changed_count Int @default(0)
 unchanged_count Int @default(0)
 applied_count Int @default(0)
 rejected_count Int @default(0)
 needs_review_count Int @default(0)
 available_at DateTime @default(now()) @db.Timestamptz(3)
 attempt_count Int @default(0)
 worker_id String? @db.Uuid
 lease_version Int @default(0)
 lease_expires_at DateTime? @db.Timestamptz(3)
 started_at DateTime? @db.Timestamptz(3)
 finished_at DateTime? @db.Timestamptz(3)
 last_error_code String? @db.VarChar(32)
 created_at DateTime @default(now()) @db.Timestamptz(3)
 updated_at DateTime @default(now()) @db.Timestamptz(3)
 connection CarrierConnection? @relation(fields:[carrier_connection_id],references:[id],onDelete:SetNull,onUpdate:NoAction)
 owner User @relation(fields:[owner_user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 items SyncJobItem[]
 createdSources SyncSourceIdentity[] @relation("created_sync")
 appliedSources SyncSourceIdentity[] @relation("applied_sync")
 // Partial uq_sync_jobs_active is migration-owned.
 @@index([status,available_at],map:"idx_sync_jobs_ready")
 @@index([owner_user_id,carrier_connection_id,created_at(sort:Desc),id(sort:Desc)],map:"idx_sync_jobs_owner")
 @@index([carrier_connection_id],map:"idx_sync_jobs_connection")
 @@map("sync_jobs")
}
model SyncSourceIdentity {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 owner_user_id String @db.Uuid
 provider String @db.VarChar(32)
 external_account_id String @db.VarChar(128)
 sync_type String @db.VarChar(32)
 source_key_scheme String @db.VarChar(64)
 source_key String @db.Text
 source_key_hash String @db.VarChar(64)
 customer_id String? @db.Uuid
 link_origin String? @db.VarChar(32)
 created_by_sync_job_id String? @db.Uuid
 last_applied_sync_job_id String? @db.Uuid
 last_resolved_hash String? @db.VarChar(64)
 resolved_processor_version Int?
 resolved_outcome String? @db.VarChar(32)
 last_observed_hash String? @db.VarChar(64)
 last_applied_hash String? @db.VarChar(64)
 applied_processor_version Int?
 observed_source_version Int @default(0)
 last_source_order BigInt?
 created_at DateTime @default(now()) @db.Timestamptz(3)
 updated_at DateTime @default(now()) @db.Timestamptz(3)
 owner User @relation(fields:[owner_user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 customer Customer? @relation(fields:[customer_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 createdBy SyncJob? @relation("created_sync",fields:[created_by_sync_job_id],references:[id],onDelete:SetNull,onUpdate:NoAction)
 appliedBy SyncJob? @relation("applied_sync",fields:[last_applied_sync_job_id],references:[id],onDelete:SetNull,onUpdate:NoAction)
 record ProviderSourceRecord?
 items SyncJobItem[]
 @@unique([owner_user_id,provider,external_account_id,sync_type,source_key_scheme,source_key_hash])
 // Partial nonnull customer_id index is SQL-owned by 20261104000000_sync_fk_indexes.
 @@map("sync_source_identities")
}
model ProviderSourceRecord {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 source_identity_id String @unique @db.Uuid
 normalized_payload Json @db.JsonB
 payload_hash String @db.VarChar(64)
 source_version Int
 applied_version Int @default(0)
 resolved_version Int @default(0)
 processor_version Int
 applied_processor_version Int?
 processing_status String @default("PENDING") @db.VarChar(32)
 attempt_count Int @default(0)
 last_error_code String? @db.VarChar(32)
 next_retry_at DateTime? @db.Timestamptz(3)
 created_at DateTime @default(now()) @db.Timestamptz(3)
 updated_at DateTime @default(now()) @db.Timestamptz(3)
 processed_at DateTime? @db.Timestamptz(3)
 identity SyncSourceIdentity @relation(fields:[source_identity_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
 @@map("provider_source_records")
}
model SyncJobItem {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 job_id String @db.Uuid
 source_identity_id String @db.Uuid
 source_version Int
 processor_version Int
 processing_outcome String @default("PENDING") @db.VarChar(32)
 attempt_count Int @default(0)
 last_error_code String? @db.VarChar(32)
 created_at DateTime @default(now()) @db.Timestamptz(3)
 processed_at DateTime? @db.Timestamptz(3)
 job SyncJob @relation(fields:[job_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
 identity SyncSourceIdentity @relation(fields:[source_identity_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 @@unique([job_id,source_identity_id,source_version,processor_version])
 @@index([job_id,processing_outcome,id],map:"idx_sync_job_items_pending")
 @@index([source_identity_id],map:"idx_sync_job_items_source")
 @@map("sync_job_items")
}
model SyncProviderBudget {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 provider String @db.VarChar(32)
 slot Int
 lease_token String? @db.Uuid
 lease_expires_at DateTime? @db.Timestamptz(3)
 blocked_until DateTime? @db.Timestamptz(3)
 failures Int @default(0)
 @@unique([provider,slot])
 @@map("sync_provider_budget")
}
