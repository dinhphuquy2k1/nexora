{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/boundaries.mjs && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/check-test-discovery.mjs \"scripts/**/*.test.mjs\" && node --test \"scripts/**/*.test.mjs\" && turbo run test",
    "test:integration": "pnpm --filter @nexora/api test:integration",
    "mfa:enroll": "node scripts/mfa-enroll.mjs",
    "user:create": "node scripts/user-create.mjs",
    "contracts:generate": "pnpm --filter @nexora/api exec tsc -p tsconfig.contract.json && node apps/api/.contracts/openapi.js && pnpm --filter @nexora/sdk generate",
    "contracts:check": "node scripts/contracts-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "preflight:check": "node scripts/preflight-policy-check.mjs",
    "test:preflight": "node --test scripts/preflight-policy-check.test.mjs",
    "test:operations": "node --test scripts/smoke-checks.test.mjs scripts/public-authority.test.mjs",
    "test:docs": "node --test scripts/docs-check.test.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm preflight:check && pnpm docs:check && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm build",
    "test:lint": "node --test scripts/eslint-rules/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "turbo": "2.11.7",
    "prettier": "3.6.2",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "concurrently": "9.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "js-yaml@>=5.0.0 <5.4.1": "5.4.1",
      "pg": "8.23.1",
      "mysql2": "3.23.1",
      "shell-quote": "1.9.0"
    }
  }
}
