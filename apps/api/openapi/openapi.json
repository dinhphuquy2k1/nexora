  "info": {
    "title": "Nexora foundation",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "CarrierProviderSummaryDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "uniship"
            ]
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "displayName"
        ]
      },
      "CarriersDto": {
        "type": "object",
        "properties": {
          "carriers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CarrierProviderSummaryDto"
            }
          }
        },
        "required": [
          "carriers"
        ]
      },
      "CarrierConnectionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string",
            "enum": [
              "uniship"
            ]
          },
          "externalAccountId": {
            "type": "string"
          },
          "loginIdentifier": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "CONNECTED",
              "REAUTH_REQUIRED",
              "ERROR"
            ]
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "externalAccountId",
          "loginIdentifier",
          "displayName",
          "status",
          "lastVerifiedAt",
          "createdAt"
        ]
      },
      "ConnectionsDto": {
        "type": "object",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CarrierConnectionDto"
            }
          }
        },
        "required": [
          "connections"
        ]
      },
      "RenameConnectionDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "displayName"
        ]
      },
      "ConnectionDto": {
        "type": "object",
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/CarrierConnectionDto"
          }
        },
        "required": [
          "connection"
        ]
      },
      "ConnectionDeletedDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "success"
        ]
      },
      "ConnectCarrierDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "uniship"
            ]
          },
          "loginIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Required nonblank username for Uniship. Future providers without username/email will use their own request schema."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          },
          "displayName": {
