{
  "name": "@nexora/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node ../../scripts/check-test-discovery.mjs \"test/**/*.test.mjs\" && node --test \"test/**/*.test.mjs\"",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "test:migrations": "node test/migration.mjs",
    "test:customer:sql": "node ../../scripts/provision-cluster-smoke.mjs --suite=customer-sql",
    "test:provision:cluster": "node ../../scripts/provision-cluster-smoke.mjs --suite=provision",
    "test:cluster": "node ../../scripts/provision-cluster-smoke.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
