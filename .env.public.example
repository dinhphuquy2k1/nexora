# Copy to an untracked mode0600 .env.public. Required values deliberately unset.
# Use with compose.yml + compose.public.yml. Not the unpublished release template.
PUBLIC_FQDN=
PUBLIC_ORIGIN=
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# Confirm non-overlap with actual host/VPN routes before using these defaults.
PUBLIC_INGRESS_SUBNET=172.30.10.0/24
PUBLIC_BACKEND_SUBNET=172.30.11.0/24
PUBLIC_INGRESS_IPV4=172.30.10.2
PUBLIC_WEB_FRONTEND_IPV4=172.30.10.3
PUBLIC_WEB_BACKEND_IPV4=172.30.11.3
PUBLIC_API_IPV4=172.30.11.4
# Supply independent Identity/Carrier keyrings securely through operator environment.
# Never copy secrets into this example, argv/history, build args, Web or Git.
# IDENTITY_KEYRING_JSON=<existing separately held keyring>
# IDENTITY_ACTIVE_KEY_VERSION=<existing active version>
# CARRIER_KEYRING_JSON=<existing separately held keyring>
# CARRIER_ACTIVE_KEY_VERSION=<existing active version>
